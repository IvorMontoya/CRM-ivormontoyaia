# Ejemplo de variables de entorno. Copia este archivo a .env.local y rellena los valores.
# NO pongas valores reales aquí. Este archivo sí se publica; .env.local no.

# --- Firebase: configuración pública del SDK cliente ---
# Son identificadores de proyecto, no secretos. La seguridad depende de las reglas de Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# --- Firebase: credenciales privadas de administración ---
# NUNCA publiques estos valores. Solo deben existir en el entorno de servidor o en secretos del proveedor de CI.
# FIREBASE_ADMIN_PROJECT_ID=your-project-id
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
